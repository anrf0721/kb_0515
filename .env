# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径（根据下载模型的成功提示来设置）
BGE_M3_PATH=E:\ai_model\models\models\BAAI--bge-m3\snapshots\master
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备，cuda:0表示使用第1块GPU，cpu表示使用CPU，cuda:N表示第N+1块GPU
BGE_DEVICE=cuda:0
# 是否使用半精度（True/False）1=开启（GPU加速更高效），0=关闭（兼容低版本GPU/CPU）
BGE_FP16=True
# BGE 编码批处理大小（每批处理的文本条数）
BGE_BATCH_SIZE=32

